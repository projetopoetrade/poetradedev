# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# backups de .env: `.env*.local` não pega `.env.local.bak-20260729`, e um
# desses commitado vaza service role key e token do Sanity.
.env.local.bak-*

public/robots.txt
public/sitemap*.xml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local IDE / agent tooling (não deve ir para o repositório)
/.vscode/
/.agents/
/.claude/
/.cursor/

# artefatos locais de testes/relatórios
/report.json
/test-tree-url/
/test_webhook.py
/skills-lock.json
/ninja.json
/read_ninja.js
/test-pobbin.mjs
/ts_error.txt
/scratch/
/.playwright-mcp/
/squirrel.toml

# artefatos de auditoria (squirrel) e screenshots de debug
/*.csv
/rf-*.png

# CLI do Supabase (gerado pelo link do projeto)
supabase/.temp/
